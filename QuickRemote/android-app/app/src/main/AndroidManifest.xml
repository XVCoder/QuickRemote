<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        远程会话期间的 CPU 保活锁：屏幕熄灭后 CPU 不被挂起，隧道 socket 才能持续收发。
        ⚠️ 它**不能**防止进程被系统冻结 —— 防冻结靠下面的前台服务（见 RemoteSessionService 注释）。
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
        会话前台服务：「切到其他应用不断开」的唯一可靠手段。
        Android 14 起，cached 应用 10 秒后即被冻结，且系统会掐掉被冻结应用的全部 TCP socket；
        wakelock 不在冻结豁免清单内。前台服务把进程 adj 提到 200（可感知），根本进不了 cached。
        connectedDevice 类型对应「与外部设备的网络长连接」语义。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android 13+ 前台服务的通知需用户授权才可见（未授权不影响保活，但用户看不到会话在跑） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        App 内的「扫码导入」需要相机。仅在扫码页使用，不申请麦克风等无关权限。
        required=false：没有摄像头的设备（极少数）仍可安装，用「粘贴配置导入」完成配置。
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
        ⚠️ 这两条 feature 显式声明 required=false 不能省：只要申请了 CAMERA 权限，
        aapt 会**隐式**补一条 `android.hardware.camera`(required=true)，导致无摄像头设备
        在应用商店/Play 被过滤掉。显式声明（含 camera.any）才会覆盖为「非必需」。
    -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- App 内下载更新包并唤起系统安装器（Android 8+ 需声明才能触发"允许安装未知应用"引导） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".QuickRemoteApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.QuickRemote"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.QuickRemote">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                手机配对深链：PC 端生成二维码（内容 quickremote://pair?d=...）。
                ⚠️ 系统相机与第三方扫码器不处理自定义 scheme，扫了不会拉起本 App，
                所以扫二维码的主路径是 App 内置的「扫码导入」页（CameraX + ZXing）。
                这个 intent-filter 只作为补充：浏览器等能打开 quickremote:// 的 App 仍可唤起。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="quickremote" android:host="pair" />
            </intent-filter>
        </activity>

        <!--
            会话前台服务：会话活跃期间常驻，把进程 adj 提到可感知级别（200），
            使 App 切到其他应用后不被冻结、TCP socket 不被系统掐断。
            stopWithTask=true：用户从最近任务划掉 App 视为明确关闭，会话随之结束。
        -->
        <service
            android:name=".services.RemoteSessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="true" />

        <!-- App 内更新：把下载到私有目录的 APK 经 content:// 授权给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
