<Window x:Class="QuickRemote.PCClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:QuickRemote.PCClient.Models"
        Title="QuickRemote PC" Height="680" Width="520"
        Icon="app.png"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <!-- 圆角窗口边框 -->
        <Border x:Key="WindowShell" CornerRadius="12"/>

        <!-- 开关切换按钮模板 -->
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="track" CornerRadius="10"
                                Background="{StaticResource BorderLightBrush}"
                                BorderThickness="0">
                            <Border x:Name="thumb" Width="16" Height="16"
                                    CornerRadius="8"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="2,0,0,0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="thumbTransform" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="16" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 普通按钮 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（强调） -->
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 标题栏圆形按钮 -->
        <Style x:Key="TitleCircleButton" TargetType="Button">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置项输入框 -->
        <Style x:Key="SettingInput" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Right"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置项下拉框（深色） -->
        <Style x:Key="SettingCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxDropDownHeight" Value="240"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="bd" Property="Opacity" Value="0.25"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" Foreground="White"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{StaticResource BgPrimaryBrush}"
                                                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  Margin="8,5,4,5"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <!-- 选中项文本（经 ContentPresenter 转发到 ToggleButton 内容区） -->
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border Background="{StaticResource BgPrimaryBrush}"
                                        BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                        CornerRadius="4" Margin="0,2,0,0" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter Margin="2"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态点脉冲动画 -->
        <Storyboard x:Key="PulseStoryboard" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="StatusDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.5" Duration="0:0:1"/>
        </Storyboard>
    </Window.Resources>

    <!-- 圆角窗口外壳 -->
    <Border Background="{StaticResource BgSecondaryBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ 标题栏 ============ -->
            <Border Grid.Row="0" Background="{StaticResource BgPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="38" Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="Medium"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="QuickRemote" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                        <Run Text=" PC"/>
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPin" Content="置顶" Click="BtnPin_Click"
                                Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                                BorderThickness="0" Cursor="Hand" FontSize="11" Padding="6,3" Margin="0,0,10,0"/>
                        <Button x:Name="BtnMinimize" Style="{StaticResource TitleCircleButton}"
                                Background="#F59E0B" Margin="0,0,8,0" Click="BtnMinimize_Click"/>
                        <Button x:Name="BtnClose" Style="{StaticResource TitleCircleButton}"
                                Background="#EF4444" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 内容区 ============ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,20,20,8"
                          Style="{StaticResource DarkScrollBar}">
                <StackPanel>

                    <!-- 服务器状态卡片 -->
                    <Border Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="服务器状态"
                                           FontSize="11" FontWeight="Medium"
                                           Foreground="{StaticResource TextMutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="LayoutTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                             VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Connected">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Connecting">
                                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Reconnecting">
                                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,8">
                                    <TextBlock Text="服务器地址" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding ServerAddressDisplay}" FontSize="12"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="设备 ID" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding DeviceId}" FontSize="12"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="心跳" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding HeartbeatText}" FontSize="12"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="版本" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock FontSize="12"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text="v"/><Run Text="{Binding Version, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- 连接状态消息 -->
                            <TextBlock Text="{Binding ConnectionMessage}"
                                       FontSize="11" Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontFamily="{StaticResource MonoFont}"/>

                            <!-- 查看日志按钮 -->
                            <TextBlock HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Hyperlink Command="{Binding ViewLogsCommand}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextDecorations="Underline">
                                    <Run Text="查看日志" FontSize="11"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 当前远程会话 -->
                    <TextBlock Text="当前远程会话" FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="2,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Sessions}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SessionInfo}">
                                <Border Background="{StaticResource BgCardBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="14,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Background="#1E3A5F" CornerRadius="4"
                                                        Width="16" Height="16" Margin="0,0,8,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="📱" FontSize="10"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding DeviceName}" FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock FontSize="11"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextMutedBrush}">
                                                <Run Text="{Binding ClientIp}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding ModeText}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DurationText}" FontSize="12"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding TrafficText}" FontSize="10"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空会话状态 -->
                    <Border Padding="0,16" Visibility="{Binding HasSessions, Converter={StaticResource InverseBoolToVisConverter}}">
                        <TextBlock Text="暂无活跃远程会话" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- 远程设备（PC→PC 远程控制） -->
                    <TextBlock Text="远程设备" FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="2,16,0,8"/>
                    <ItemsControl ItemsSource="{Binding RemoteDevices}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:RemoteDeviceInfo}">
                                <Border Background="{StaticResource BgCardBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="14,10" Margin="0,0,0,8">
                                    <Grid Cursor="Hand">
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftClick"
                                                          Command="{Binding DataContext.ConnectDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"/>
                                        </Grid.InputBindings>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Background="#1E3A5F" CornerRadius="4"
                                                        Width="16" Height="16" Margin="0,0,8,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="🖥" FontSize="10"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <!-- 本机私有备注（仅本机可见；为空时隐藏） -->
                                                <TextBlock FontSize="11" FontStyle="Italic" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                                           MaxWidth="140"
                                                           ToolTip="本机备注（仅本机可见）">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Remark}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Remark}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="〔"/><Run Text="{Binding Remark, Mode=OneWay}"/><Run Text="〕"/>
                                                </TextBlock>
                                                <Ellipse Width="7" Height="7" Margin="12,0,5,0"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock FontSize="11"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis">
                                                <!-- Run.Text 默认 TwoWay，只读属性必须显式 OneWay，
                                                     否则渲染即抛 XamlParseException → 布局无限重试 → UI 死循环（v1.1.46 修复） -->
                                                <Run Text="{Binding DeviceId, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding SubtitleText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="&#x270E;" FontSize="13"
                                                    Padding="8,4" Margin="10,0,0,0"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    ToolTip="设置备注（仅本机可见，不影响设备名称）"
                                                    Command="{Binding DataContext.SetDeviceRemarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <!-- 软删除：仅离线设备可见，上线自动恢复 -->
                                            <Button Content="&#x2715;" FontSize="12"
                                                    Padding="8,4" Margin="2,0,0,0"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    ToolTip="从列表移除（仅本机隐藏；设备上线后自动恢复）"
                                                    Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空设备状态 -->
                    <Border Padding="0,12" Visibility="{Binding HasRemoteDevices, Converter={StaticResource InverseBoolToVisConverter}}">
                        <TextBlock Text="暂无其他设备，其他 PC 连接服务器后将自动出现在此处" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </Border>

                    <!-- 基本配置 -->
                    <TextBlock Text="基本配置" FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="2,16,0,8"/>
                    <Border Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="服务器地址" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SettingInput}"
                                         Text="{Binding ServerAddressInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="预共享密钥" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SettingInput}"
                                         Text="{Binding PreSharedKeyInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="设备名称" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SettingInput}"
                                         Text="{Binding DeviceNameInput, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="留空则由服务器自动分配默认名称"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="开机自启动" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding AutoStart, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="启动时检查更新" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding CheckUpdateOnStart, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="自动上传错误日志" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding AutoUploadLogs, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 远程配置（本机远程其他主机时的参数） -->
                    <TextBlock Text="远程配置（本机远程其他主机时）" FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="2,0,0,8"/>
                    <Border Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="目标分辨率上限" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="远程画面超过该高度时自动等比缩小以节省流量；原始分辨率 = 不缩放"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                          ItemsSource="{Binding MaxHeightOptions}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ViewerTargetMaxHeight, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="图像质量" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="按百分比缩放被控端编码码率：低质量省流量，高质量画质清晰"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                          ItemsSource="{Binding QualityOptions}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ViewerQualityPercent, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="目标帧率" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="请求被控端按该帧率推送画面（5-60 fps）"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                          ItemsSource="{Binding FpsOptions}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ViewerFps, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="颜色深度" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="16 位高彩色会量化画面色彩以提升压缩率"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                          ItemsSource="{Binding ColorDepthOptions}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ViewerColorDepth, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="局域网直连优先" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="同网段时优先直连（低延迟）；关闭后强制走公网中继"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding ViewerPreferLan, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ============ 底部按钮栏 ============ -->
            <Border Grid.Row="2" Background="{StaticResource BgPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="更新记录" Style="{StaticResource ActionButton}"
                            Margin="0,0,4,0" Command="{Binding ShowChangelogCommand}"/>
                    <Button Grid.Column="1" Content="导出配置" Style="{StaticResource ActionButton}"
                            Margin="4,0,4,0" Command="{Binding ExportConfigCommand}"/>
                    <Button Grid.Column="2" Content="检查更新" Style="{StaticResource ActionButton}"
                            Margin="4,0,4,0" Command="{Binding CheckUpdateCommand}"/>
                    <Button Grid.Column="3" Content="保存设置" Style="{StaticResource PrimaryActionButton}"
                            Margin="4,0,0,0" Command="{Binding SaveSettingsCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
