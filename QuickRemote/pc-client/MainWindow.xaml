<Window x:Class="QuickRemote.PCClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:QuickRemote.PCClient.Models"
        Title="QuickRemote PC" Height="680" Width="520"
        Icon="app.png"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <!-- 状态点脉冲动画 -->
        <Storyboard x:Key="PulseStoryboard" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="StatusDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.5" Duration="0:0:1"/>
        </Storyboard>
    </Window.Resources>

    <!-- 圆角窗口外壳 -->
    <Border Background="{StaticResource BgSecondaryBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ 标题栏 ============ -->
            <Border Grid.Row="0" Background="Transparent"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="44" Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}">
                        <Run Text="QuickRemote" Foreground="{StaticResource AccentBrush}"/>
                        <Run Text=" PC"/>
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPin" Content="置顶" Click="BtnPin_Click"
                                Style="{StaticResource TitleIconButton}"
                                Width="Auto" Padding="8,0" FontSize="11" Margin="0,0,4,0"/>
                        <Button x:Name="BtnMinimize" Style="{StaticResource TitleIconButton}"
                                Margin="0,0,4,0" Click="BtnMinimize_Click">
                            <Path Data="M2,6 L10,6" Width="12" Height="12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button x:Name="BtnClose" Style="{StaticResource TitleCloseButton}"
                                Click="BtnClose_Click">
                            <Path Data="M3,3 L9,9 M9,3 L3,9" Width="12" Height="12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 内容区 ============ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,20,20,8"
                          Style="{StaticResource DarkScrollBar}">
                <StackPanel>

                    <!-- 服务器状态卡片 -->
                    <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="服务器状态"
                                           FontSize="11" FontWeight="Medium"
                                           Foreground="{StaticResource TextMutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="LayoutTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                             VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Connected">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Connecting">
                                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Reconnecting">
                                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,8">
                                    <TextBlock Text="服务器地址" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding ServerAddressDisplay}" FontSize="12"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="设备 ID" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding DeviceId}" FontSize="12"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="心跳" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding HeartbeatText}" FontSize="12"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="版本" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock FontSize="12"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text="v"/><Run Text="{Binding Version, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- 连接状态消息 -->
                            <TextBlock Text="{Binding ConnectionMessage}"
                                       FontSize="11" Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontFamily="{StaticResource MonoFont}"/>

                            <!-- 查看日志按钮 -->
                            <TextBlock HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Hyperlink Command="{Binding ViewLogsCommand}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextDecorations="Underline">
                                    <Run Text="查看日志" FontSize="11"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 当前远程会话 -->
                    <TextBlock Text="当前远程会话" FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="2,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Sessions}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SessionInfo}">
                                <Border Style="{StaticResource CardBorder}"
                                        Padding="14,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Background="#1E3A5F" CornerRadius="4"
                                                        Width="16" Height="16" Margin="0,0,8,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="📱" FontSize="10"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding DeviceName}" FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock FontSize="11"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextMutedBrush}">
                                                <Run Text="{Binding ClientIp}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding ModeText}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DurationText}" FontSize="12"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding TrafficText}" FontSize="10"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空会话状态 -->
                    <Border Padding="0,16" Visibility="{Binding HasSessions, Converter={StaticResource InverseBoolToVisConverter}}">
                        <TextBlock Text="暂无活跃远程会话" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- 远程设备（PC→PC 远程控制） -->
                    <TextBlock Text="远程设备" Style="{StaticResource SectionHeader}" Margin="2,16,0,8"/>
                    <ItemsControl ItemsSource="{Binding RemoteDevices}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:RemoteDeviceInfo}">
                                <Border Style="{StaticResource CardBorder}"
                                        Padding="14,10" Margin="0,0,0,8">
                                    <Grid Cursor="Hand">
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftClick"
                                                          Command="{Binding DataContext.ConnectDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"/>
                                        </Grid.InputBindings>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Background="#2A3A50" CornerRadius="6"
                                                        Width="18" Height="18" Margin="0,0,8,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="🖥" FontSize="10"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <!-- 本机私有备注（仅本机可见；为空时隐藏） -->
                                                <TextBlock FontSize="11" FontStyle="Italic" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                                           MaxWidth="140"
                                                           ToolTip="本机备注（仅本机可见）">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Remark}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Remark}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="〔"/><Run Text="{Binding Remark, Mode=OneWay}"/><Run Text="〕"/>
                                                </TextBlock>
                                                <Ellipse Width="7" Height="7" Margin="12,0,5,0"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock FontSize="11"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis">
                                                <!-- Run.Text 默认 TwoWay，只读属性必须显式 OneWay，
                                                     否则渲染即抛 XamlParseException → 布局无限重试 → UI 死循环（v1.1.46 修复） -->
                                                <Run Text="{Binding DeviceId, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding SubtitleText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="&#x270E;" FontSize="13"
                                                    Style="{StaticResource ListIconButton}"
                                                    Margin="10,0,0,0"
                                                    ToolTip="设置备注（仅本机可见，不影响设备名称）"
                                                    Command="{Binding DataContext.SetDeviceRemarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <!-- 软删除：仅离线设备可见，上线自动恢复 -->
                                            <Button Content="&#x2715;" FontSize="12"
                                                    Margin="2,0,0,0"
                                                    ToolTip="从列表移除（仅本机隐藏；设备上线后自动恢复）"
                                                    Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ListIconButton}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空设备状态 -->
                    <Border Padding="0,12" Visibility="{Binding HasRemoteDevices, Converter={StaticResource InverseBoolToVisConverter}}">
                        <TextBlock Text="暂无其他设备，其他 PC 连接服务器后将自动出现在此处" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </Border>

                    <!-- 基本配置 -->
                    <TextBlock Text="基本配置" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="服务器地址" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SettingInput}"
                                         Text="{Binding ServerAddressInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="预共享密钥" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SettingInput}"
                                         Text="{Binding PreSharedKeyInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="设备名称" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SettingInput}"
                                         Text="{Binding DeviceNameInput, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="留空则由服务器自动分配默认名称"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="开机自启动" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding AutoStart, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="启动时检查更新" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding CheckUpdateOnStart, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="自动上传错误日志" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding AutoUploadLogs, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 远程配置（本机远程其他主机时的参数） -->
                    <TextBlock Text="远程配置（本机远程其他主机时）" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="目标分辨率上限" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="远程画面超过该高度时自动等比缩小以节省流量；原始分辨率 = 不缩放"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                          ItemsSource="{Binding MaxHeightOptions}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ViewerTargetMaxHeight, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="图像质量" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="按百分比缩放被控端编码码率：低质量省流量，高质量画质清晰"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                          ItemsSource="{Binding QualityOptions}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ViewerQualityPercent, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="目标帧率" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="请求被控端按该帧率推送画面（5-60 fps）"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                          ItemsSource="{Binding FpsOptions}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ViewerFps, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="颜色深度" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="16 位高彩色会量化画面色彩以提升压缩率"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                          ItemsSource="{Binding ColorDepthOptions}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ViewerColorDepth, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="局域网直连优先" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="同网段时优先直连（低延迟）；关闭后强制走公网中继"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding ViewerPreferLan, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 被远程安全（本机被其他设备连接时） -->
                    <TextBlock Text="被远程安全（本机被其他设备连接时）" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="访问验证码" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="设置后其他设备连接本机需输入该验证码，验证通过才能远程；留空 = 不验证"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SettingInput}"
                                         Text="{Binding AccessCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="设置后其他设备连接本机需输入该验证码，验证通过才能远程；留空 = 不验证"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="断开时自动锁屏" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="远程连接断开时自动锁定本机桌面（LockWorkStation），保护未锁屏离开时的隐私"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding LockOnDisconnect, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ============ 底部按钮栏 ============ -->
            <Border Grid.Row="2" Background="Transparent"
                    CornerRadius="0,0,12,12" Padding="20,8,20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="更新记录" Style="{StaticResource ActionButton}"
                            Margin="0,0,4,0" Command="{Binding ShowChangelogCommand}"/>
                    <Button Grid.Column="1" Content="导出配置" Style="{StaticResource ActionButton}"
                            Margin="4,0,4,0" Command="{Binding ExportConfigCommand}"/>
                    <Button Grid.Column="2" Content="检查更新" Style="{StaticResource ActionButton}"
                            Margin="4,0,4,0" Command="{Binding CheckUpdateCommand}"/>
                    <Button Grid.Column="3" Content="保存设置" Style="{StaticResource PrimaryActionButton}"
                            Margin="4,0,0,0" Command="{Binding SaveSettingsCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
