<Window x:Class="QuickRemote.PCClient.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}">
    <Border Background="{StaticResource BgSecondaryBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="14">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="46" Margin="20,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TitleText" Text="提示"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="BtnClose"
                            Click="BtnClose_Click" Style="{StaticResource TitleCloseButton}">
                        <Path Data="M3,3 L9,9 M9,3 L3,9" Width="12" Height="12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容 -->
            <Grid Grid.Row="1" Margin="22,14,22,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" x:Name="IconBadge" Width="36" Height="36"
                        CornerRadius="18" VerticalAlignment="Top" Margin="0,2,14,0">
                    <TextBlock x:Name="IconText" Text="i" FontSize="18" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" x:Name="MessageText" Text=""
                           FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Top"/>
            </Grid>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="20,14,20,20">
                <Button x:Name="BtnCancel" Content="取消" MinWidth="88"
                        Click="BtnCancel_Click" Margin="0,0,10,0"
                        Style="{StaticResource ActionButton}"/>
                <Button x:Name="BtnOk" Content="确定" MinWidth="88"
                        Click="BtnOk_Click"
                        Style="{StaticResource PrimaryActionButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
