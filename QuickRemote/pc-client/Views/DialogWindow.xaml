<Window x:Class="QuickRemote.PCClient.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}">
    <Border Background="{StaticResource BgSecondaryBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="12">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{StaticResource BgPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="42" Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TitleText" Text="提示"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="BtnClose" Content="&#x2715;"
                            Click="BtnClose_Click" Cursor="Hand"
                            Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                            BorderThickness="0" FontSize="13" Padding="6,2"/>
                </Grid>
            </Border>

            <!-- 内容 -->
            <Grid Grid.Row="1" Margin="20,20,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" x:Name="IconBadge" Width="36" Height="36"
                        CornerRadius="18" VerticalAlignment="Top" Margin="0,2,14,0">
                    <TextBlock x:Name="IconText" Text="i" FontSize="18" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" x:Name="MessageText" Text=""
                           FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Top"/>
            </Grid>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="20,12,20,18">
                <Button x:Name="BtnCancel" Content="取消" MinWidth="84"
                        Click="BtnCancel_Click" Cursor="Hand"
                        Margin="0,0,10,0"
                        Background="{StaticResource BgCardBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1" Padding="16,7" FontSize="12" FontWeight="Medium"/>
                <Button x:Name="BtnOk" Content="确定" MinWidth="84"
                        Click="BtnOk_Click" Cursor="Hand"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1" Padding="16,7" FontSize="12" FontWeight="Medium"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
