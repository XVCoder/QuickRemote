<Window x:Class="QuickRemote.PCClient.Views.InputDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}">
    <Border Background="{StaticResource BgSecondaryBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{StaticResource BgPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="42" Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TitleText" Text="输入"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="&#x2715;"
                            Click="BtnClose_Click" Cursor="Hand"
                            Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                            BorderThickness="0" FontSize="13" Padding="6,2"/>
                </Grid>
            </Border>

            <!-- 内容 -->
            <StackPanel Grid.Row="1" Margin="20,18,20,8">
                <TextBlock x:Name="MessageText" Text=""
                           FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBox x:Name="InputBox" FontSize="13" Padding="8,6"
                         Background="{StaticResource BgPrimaryBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         CaretBrush="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderLightBrush}"
                         BorderThickness="1"
                         KeyDown="InputBox_KeyDown"/>
            </StackPanel>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="20,12,20,18">
                <Button Content="取消" MinWidth="84"
                        Click="BtnCancel_Click" Cursor="Hand"
                        Margin="0,0,10,0"
                        Background="{StaticResource BgCardBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1" Padding="16,7" FontSize="12" FontWeight="Medium"/>
                <Button x:Name="BtnOk" Content="确定" MinWidth="84"
                        Click="BtnOk_Click" Cursor="Hand"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1" Padding="16,7" FontSize="12" FontWeight="Medium"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
