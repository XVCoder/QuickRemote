<Window x:Class="QuickRemote.PCClient.Views.InputDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}">
    <Border Background="{StaticResource BgSecondaryBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="46" Margin="20,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TitleText" Text="输入"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Click="BtnClose_Click"
                            Style="{StaticResource TitleCloseButton}">
                        <Path Data="M3,3 L9,9 M9,3 L3,9" Width="12" Height="12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容 -->
            <StackPanel Grid.Row="1" Margin="22,12,22,8">
                <TextBlock x:Name="MessageText" Text=""
                           FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBox x:Name="InputBox" FontSize="13"
                         KeyDown="InputBox_KeyDown">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource SettingInput}">
                            <Setter Property="Width" Value="NaN"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="TextAlignment" Value="Left"/>
                            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </StackPanel>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="20,14,20,20">
                <Button Content="取消" MinWidth="88"
                        Click="BtnCancel_Click" Margin="0,0,10,0"
                        Style="{StaticResource ActionButton}"/>
                <Button x:Name="BtnOk" Content="确定" MinWidth="88"
                        Click="BtnOk_Click"
                        Style="{StaticResource PrimaryActionButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
