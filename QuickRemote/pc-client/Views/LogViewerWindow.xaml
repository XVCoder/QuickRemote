<Window x:Class="QuickRemote.PCClient.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日志查看" Height="560" Width="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">
    <Border Background="{StaticResource BgSecondaryBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="46" Margin="20,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="日志查看" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="刷新" Click="BtnRefresh_Click"
                                Style="{StaticResource TitleIconButton}"
                                Width="Auto" Padding="10,0" FontSize="12" Margin="0,0,4,0"/>
                        <Button Click="BtnClose_Click" Style="{StaticResource TitleCloseButton}">
                            <Path Data="M3,3 L9,9 M9,3 L3,9" Width="12" Height="12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 日志内容（只读等宽） -->
            <Border Grid.Row="1" Background="{StaticResource BgCardBrush}"
                    CornerRadius="10" Margin="20,4,20,12">
                <TextBox x:Name="LogTextBox"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderThickness="0"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="{StaticResource MonoFont}"
                         FontSize="12"
                         Padding="14,10"/>
            </Border>

            <!-- 底部 -->
            <Border Grid.Row="2" Background="Transparent" Padding="20,0,20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="清空日志" Click="BtnClear_Click"
                            Style="{StaticResource TitleIconButton}"
                            Foreground="{StaticResource DangerBrush}"
                            Width="Auto" Padding="10,0" FontSize="12" Margin="0,4,0,0"/>
                    <Button Content="打开日志目录" Click="BtnOpenFolder_Click"
                            Style="{StaticResource TitleIconButton}"
                            Width="Auto" Padding="10,0" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
