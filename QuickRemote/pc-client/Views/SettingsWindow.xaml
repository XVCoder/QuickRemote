<Window x:Class="QuickRemote.PCClient.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="600" Width="780"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <!-- 左侧导航项：图标 + 文字，选中态圆角高亮（参考腾讯电脑管家设置中心） -->
        <Style x:Key="NavRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BgCardBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 更新记录阅读区：内部滚动条复用主题窄轨道样式 -->
        <Style x:Key="ChangelogReader" TargetType="FlowDocumentScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="IsToolBarVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="FlowDocumentScrollViewer">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Style="{StaticResource DarkScrollBar}"
                                      CanContentScroll="True"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 意见反馈输入框：多行、左对齐、圆角，复用深色输入底色与蓝色聚焦描边 -->
        <Style x:Key="FeedbackInput" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TextMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgSecondaryBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 左侧导航栏 ============ -->
            <Border Grid.Column="0" Background="{StaticResource BgPrimaryBrush}"
                    CornerRadius="14,0,0,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Margin="10,18,10,12">
                    <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="10,0,0,18"/>

                    <RadioButton x:Name="NavBasic" GroupName="SettingsNav" IsChecked="True"
                                 Style="{StaticResource NavRadio}" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M1.5,3 L10.5,3 M1.5,6.5 L10.5,6.5 M1.5,10 L10.5,10 M4.2,1.9 L4.2,4.1 M7.6,5.4 L7.6,7.6 M5.2,8.9 L5.2,11.1"
                                  Width="12" Height="12" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Text="基本配置" FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavRemote" GroupName="SettingsNav"
                                 Style="{StaticResource NavRadio}" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M1,1.8 h10 v7 h-10 Z M4,11 h4 M6,8.8 L6,11"
                                  Width="12" Height="12" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <TextBlock Text="远程配置" FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavSecurity" GroupName="SettingsNav"
                                 Style="{StaticResource NavRadio}" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M6,1 L10.6,2.7 L10.6,6 C10.6,9.2 8.7,11 6,12 C3.3,11 1.4,9.2 1.4,6 L1.4,2.7 Z"
                                  Width="12" Height="12" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <TextBlock Text="被远程安全" FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavUpdate" GroupName="SettingsNav"
                                 Style="{StaticResource NavRadio}" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M6,1.4 L6,9 M2.8,5.9 L6,9.1 L9.2,5.9 M1.6,11.2 h8.8"
                                  Width="12" Height="12" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <TextBlock Text="版本更新" FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavFeedback" GroupName="SettingsNav"
                                 Style="{StaticResource NavRadio}" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M1.2,2.6 h9.6 v6.2 h-5.4 L2.6,11.4 v-2.6 H1.2 Z"
                                  Width="12" Height="12" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <TextBlock Text="意见反馈" FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- ============ 右侧内容区 ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 内容标题栏（可拖动）+ 关闭按钮 -->
                <Grid Grid.Row="0" Height="48" Margin="24,0,8,0"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock x:Name="SectionTitle" Text="基本配置"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Click="BtnClose_Click"
                            Style="{StaticResource TitleCloseButton}">
                        <Path Data="M3,3 L9,9 M9,3 L3,9" Width="12" Height="12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </Grid>

                <!-- 内容滚动区 -->
                <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource DarkScrollBar}"
                              Padding="24,4,20,8">
                    <Grid>
                        <!-- 基本配置 -->
                        <StackPanel x:Name="PanelBasic" Visibility="Visible">
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="服务器地址" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SettingInput}"
                                         Text="{Binding ServerAddressInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="预共享密钥" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SettingInput}"
                                         Text="{Binding PreSharedKeyInput, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="设备名称" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SettingInput}"
                                         Text="{Binding DeviceNameInput, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="留空则由服务器自动分配默认名称"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="开机自启动" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding AutoStart, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="启动时检查更新" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding CheckUpdateOnStart, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="自动上传错误日志" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding AutoUploadLogs, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="手机配对" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="生成二维码" MinWidth="100"
                                        Click="BtnPairing_Click"
                                        ToolTip="生成配对二维码，用 QuickRemote 安卓端 App 扫码即可自动填入服务器地址与密钥"
                                        Style="{StaticResource ActionButton}"/>
                            </Grid>
                        </StackPanel>

                        <!-- 远程配置（本机远程其他主机时的参数） -->
                        <StackPanel x:Name="PanelRemote" Visibility="Collapsed">
                            <TextBlock Text="本机远程其他主机时的默认参数" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,6"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="图像质量" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="按百分比缩放被控端编码码率：低质量省流量，高质量画质清晰"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                          ItemsSource="{Binding QualityOptions}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ViewerQualityPercent, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="目标帧率" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="请求被控端按该帧率推送画面（5-60 fps）"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                          ItemsSource="{Binding FpsOptions}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ViewerFps, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="颜色深度" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="16 位高彩色会量化画面色彩以提升压缩率"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource SettingCombo}"
                                          ItemsSource="{Binding ColorDepthOptions}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ViewerColorDepth, Mode=TwoWay}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="局域网直连优先" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="同网段时优先直连（低延迟）；关闭后强制走公网中继"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding ViewerPreferLan, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>

                        <!-- 被远程安全（本机被其他设备连接时） -->
                        <StackPanel x:Name="PanelSecurity" Visibility="Collapsed">
                            <TextBlock Text="本机被其他设备远程连接时的安全策略" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,6"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="访问验证码" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="开启后其他设备连接本机需输入 6 位数字验证码，验证通过才能远程；开启时必须设置验证码才能保存设置"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding AccessCodeEnabled, Mode=TwoWay}"/>
                            </Grid>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="验证码（6 位数字）" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           IsEnabled="{Binding AccessCodeEnabled}"
                                           ToolTip="设置后其他设备连接本机需输入该验证码，验证通过才能远程"/>
                                <TextBox Grid.Column="1" x:Name="AccessCodeBox" Style="{StaticResource SettingInput}"
                                         Width="110" MaxLength="6"
                                         IsEnabled="{Binding AccessCodeEnabled}"
                                         PreviewTextInput="AccessCodeBox_PreviewTextInput"
                                         Text="{Binding AccessCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="设置后其他设备连接本机需输入该验证码，验证通过才能远程"/>
                                <Button Grid.Column="2" Content="随机" Style="{StaticResource TitleIconButton}"
                                        Width="Auto" MinWidth="44"
                                        Command="{Binding GenerateAccessCodeCommand}"
                                        IsEnabled="{Binding AccessCodeEnabled}"
                                        Margin="6,0,0,0" FontSize="12" Padding="10,4"
                                        ToolTip="随机生成 6 位数字验证码"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="断开时自动锁屏" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="远程连接断开时自动锁定本机桌面（LockWorkStation），保护未锁屏离开时的隐私"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding LockOnDisconnect, Mode=TwoWay}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="剪贴板同步" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           ToolTip="会话期间与主控端双向同步纯文本剪贴板（手机复制的文字可直接在电脑粘贴，反之亦然）；关闭后不读取也不写入剪贴板"/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding ClipboardSyncEnabled, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>

                        <!-- 版本更新：检查更新 + 更新记录（原主窗口底部按钮栏与独立「更新记录」窗口并入此处） -->
                        <StackPanel x:Name="PanelUpdate" Visibility="Collapsed">
                            <Border Style="{StaticResource CardBorder}" Padding="18,16" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="当前版本" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextPrimaryBrush}">
                                            <Run Text="v"/><Run Text="{Binding Version, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding UpdateStatusText}" FontSize="11" Margin="0,5,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="检查更新" VerticalAlignment="Center"
                                            MinWidth="104" Style="{StaticResource PrimaryActionButton}"
                                            Command="{Binding CheckUpdateCommand}"/>
                                </Grid>
                            </Border>

                            <Grid Margin="2,18,2,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="更新记录" FontSize="11" FontWeight="Medium"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="刷新" Style="{StaticResource ListIconButton}"
                                        FontSize="11" Padding="8,3" ToolTip="重新拉取更新记录"
                                        Click="BtnRefreshChangelog_Click"/>
                            </Grid>

                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="6">
                                <Grid Height="296">
                                    <FlowDocumentScrollViewer x:Name="ChangelogViewer"
                                                              Style="{StaticResource ChangelogReader}"
                                                              Padding="14,10" Visibility="Collapsed"/>
                                    <TextBlock x:Name="ChangelogStatusText" Text="加载中..."
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 意见反馈：反馈内容上传到 QuickDeploy 的 quickremote/feedback 目录 -->
                        <StackPanel x:Name="PanelFeedback" Visibility="Collapsed">
                            <TextBlock Text="遇到问题或有建议？写下来直接提交给我们。" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,10"
                                       TextWrapping="Wrap"/>

                            <TextBox x:Name="FeedbackBox" Style="{StaticResource FeedbackInput}"
                                     Height="196"
                                     ToolTip="请描述遇到的问题或你的建议（越具体越容易定位，例如：操作步骤、期望结果、实际结果）"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="附带运行日志" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="勾选后会把最近 1000 行运行日志附在反馈内容下方一并提交"
                                               FontSize="10.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <ToggleButton x:Name="FeedbackWithLogsToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}" IsChecked="True"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="设备 ID" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="FeedbackDeviceIdText" Text="-"
                                           FontSize="11" FontFamily="{StaticResource MonoFont}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                            </Grid>

                            <TextBlock x:Name="FeedbackStatusText" Text="" FontSize="11" Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 底部栏：配置页显示「保存设置」，意见反馈页显示「提交反馈」 -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Padding="24,12">
                    <Grid>
                        <Button x:Name="SaveSettingsButton"
                                Content="{Binding SaveSettingsText}" Style="{StaticResource PrimaryActionButton}"
                                Padding="20,10" HorizontalAlignment="Right" MinWidth="120"
                                Command="{Binding SaveSettingsCommand}"/>
                        <Button x:Name="SubmitFeedbackButton"
                                Content="提交反馈" Style="{StaticResource PrimaryActionButton}"
                                Padding="20,10" HorizontalAlignment="Right" MinWidth="120"
                                Visibility="Collapsed"
                                Click="BtnSubmitFeedback_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
