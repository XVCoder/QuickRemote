<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QuickRemote.Updater</RootNamespace>
    <!-- 产出 update.exe，随主程序发布包一起分发 -->
    <AssemblyName>update</AssemblyName>
    <Version>1.0.1</Version>
    <Company>QuickRemote</Company>
    <Product>QuickRemote Updater</Product>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--
      单文件发布：产出一个独立的 update.exe（运行不依赖同目录的 update.dll）。
      主程序更新时会把 update.exe 单独复制到临时目录运行（避免更新过程中覆盖自身），
      非单文件模式下复制后缺少 update.dll 会导致启动失败。
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
